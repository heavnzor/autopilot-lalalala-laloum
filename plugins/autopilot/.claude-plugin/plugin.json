{
  "name": "autopilot",
  "version": "2.1.0",
  "description": "Developpement autonome depuis un ticket Jira, avec memoire versionnee et review adverse.",
  "author": {
    "name": "Elie Laloum",
    "email": "pro@elielaloum.com"
  },
  "mcpServers": {
    "autopilot": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/server.ts"
      ],
      "env": {
        "AUTOPILOT_PROJECT_ROOT": "${CLAUDE_PLUGIN_ROOT}/../.."
      },
      "timeout": 28800000
    }
  },
  "experimental": {
    "evals": "evals"
  }
}
